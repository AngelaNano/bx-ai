component {
    
    property name="hookStore";
    
    function init(){
        variables.hookStore = {};  // Stores agentId -> hooks map
        return this;
    }
    
    function register( required string agentId, required struct hooksMap ){
        if( !structKeyExists( variables.hookStore, arguments.agentId ) ){
            variables.hookStore[ arguments.agentId ] = {};
        }
        structAppend( variables.hookStore[ arguments.agentId ], arguments.hooksMap, true );
    }
    
    struct function getHooksForAgent( required string agentId ){
        return variables.hookStore.getOrDefault( arguments.agentId, {} );
    }
    
    function clearAgentHooks( required string agentId ){
        structDelete( variables.hookStore, arguments.agentId );
    }
}